# KaamSetu environment settings
#
# Is file ko copy karke ".env" naam se save karo (project root me) aur apni
# details bharo. Django isse automatically load karta hai (config/settings.py).
# ".env" ko git me commit mat karo — sirf ".env.example" rakhna hai.

# --- Core / security (production me zaroori) ---
# Development defaults: DEBUG=true, SECRET_KEY=dev fallback, ALLOWED_HOSTS=*.
# Production me: DEBUG=false karo, ek strong SECRET_KEY daalo aur hosts list karo.
# KAAMSETU_DEBUG=false
# KAAMSETU_SECRET_KEY=change-me-to-a-long-random-string
# KAAMSETU_ALLOWED_HOSTS=kaamsetu.example.com,www.kaamsetu.example.com
# KAAMSETU_CSRF_TRUSTED_ORIGINS=https://kaamsetu.example.com
# KAAMSETU_SECURE_SSL=true

# --- Gmail example ---
# Gmail: 2-Step Verification on karo -> "App password" banao -> wahi yahan daalo.
KAAMSETU_EMAIL_HOST=smtp.gmail.com
KAAMSETU_EMAIL_PORT=587
KAAMSETU_EMAIL_HOST_USER=you@gmail.com
KAAMSETU_EMAIL_HOST_PASSWORD=your-16-char-app-password
KAAMSETU_DEFAULT_FROM_EMAIL=KaamSetu <you@gmail.com>
KAAMSETU_EMAIL_USE_TLS=true

# --- Outlook / Office 365 example ---
# KAAMSETU_EMAIL_HOST=smtp.office365.com
# KAAMSETU_EMAIL_PORT=587
# KAAMSETU_EMAIL_HOST_USER=you@yourdomain.com
# KAAMSETU_EMAIL_HOST_PASSWORD=your-password
# KAAMSETU_DEFAULT_FROM_EMAIL=KaamSetu <you@yourdomain.com>
# KAAMSETU_EMAIL_USE_TLS=true

# Note: agar ye values khaali/delete kar di, to app mail ko
# BASE_DIR/sent_emails/ folder me file ke roop me likhega (dev fallback).

# --- Vision AI (uploaded video ko dekh kar skill detect karta hai) ---
# Free key: https://aistudio.google.com/apikey (Google AI Studio -> "Get API key")
# Key na ho to app chalta rahega — bas video ka naam/heuristic se skill nikalega.
KAAMSETU_GEMINI_API_KEY=
# Optional — default: gemini-2.5-flash
KAAMSETU_GEMINI_MODEL=gemini-2.5-flash
# Optional chatbot model. Google AI Studio currently offers a free tier with limits.
KAAMSETU_CHATBOT_MODEL=gemini-3.5-flash-lite
